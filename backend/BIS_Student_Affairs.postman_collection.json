{
  "info": {
    "name": "BIS Student Affairs API (Complete CRUD & Secure JWT)",
    "description": "Premium Postman Collection for testing the complete CRUD operations, input validations, query filters, and JWT Authorization flow for the BIS Student Affairs Backend System.",
